{
  "id": 6,
  "title": "EMA 指标 + 布林带 + 表达式交叉信号",
  "description": "测试 EMA + 布林带 + 自定义表达式组合策略信号。",
  "workflow_json": {
    "nodes": [
      {
        "id": "n1",
        "name": "EMA指标",
        "type": "ma",
        "parameters": {
          "windows": "12,26",
          "source_column": "close",
          "use_ema": true
        }
      },
      {
        "id": "n2",
        "name": "布林带",
        "type": "boll",
        "parameters": {
          "window": 20,
          "std_mult": 2,
          "source_column": "close"
        }
      },
      {
        "id": "n3",
        "name": "交叉信号",
        "type": "expression",
        "parameters": {
          "target_column": "signal",
          "expression": "1 if df['ema_12'] > df['ema_26'] else -1"
        }
      },
      {
        "id": "n4",
        "name": "突破上轨",
        "type": "condition",
        "parameters": {
          "condition": "df['close'] > df['boll_upper']",
          "branch": "true"
        }
      }
    ],
    "connections": {
      "n1": [
        "n2"
      ],
      "n2": [
        "n3"
      ],
      "n3": [
        "n4"
      ]
    }
  }
}