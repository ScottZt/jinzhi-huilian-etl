{
  "name": "Binance 拉取 → 重命名 → 重采样 → MACD → 写入",
  "description": "测试加密货币数据源拉取，完整数据处理链路。",
  "workflow_json": {
    "nodes": [
      {
        "id": "n1",
        "name": "拉取Binance数据",
        "type": "source_fetch",
        "parameters": {
          "source_type": "binance",
          "source_config": "{}",
          "codes": "BTCUSDT",
          "interval": "1min",
          "time_mode": "lookback",
          "lookback_days": 1,
          "parallel": false,
          "session_only": false
        }
      },
      {
        "id": "n2",
        "name": "列重命名",
        "type": "column_rename",
        "parameters": {
          "renames": "datetime=dt,vol=volume"
        }
      },
      {
        "id": "n3",
        "name": "重采样5分钟",
        "type": "resample",
        "parameters": {
          "rule": "5min",
          "time_column": "dt",
          "group_column": ""
        }
      },
      {
        "id": "n4",
        "name": "计算MACD",
        "type": "macd",
        "parameters": {
          "fast": 12,
          "slow": 26,
          "signal": 9,
          "source_column": "close"
        }
      },
      {
        "id": "n5",
        "name": "写入DuckDB",
        "type": "target_write",
        "parameters": {
          "target_type": "duckdb",
          "target_config": "{\"db_path\": \"D:/data/crypto.db\"}",
          "target_table": "btc_5min_macd",
          "batch_size": 5000,
          "on_duplicate": "ignore",
          "columns": ""
        }
      }
    ],
    "connections": {
      "n1": [
        "n2"
      ],
      "n2": [
        "n3"
      ],
      "n3": [
        "n4"
      ],
      "n4": [
        "n5"
      ]
    }
  }
}