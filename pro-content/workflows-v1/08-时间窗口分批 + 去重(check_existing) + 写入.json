{
  "name": "时间窗口分批 + 去重(check_existing) + 写入",
  "description": "测试增量 ETL 场景：按时间窗口分批，排除已有数据后写入。",
  "workflow_json": {
    "nodes": [
      {
        "id": "n1",
        "name": "时间窗口分批",
        "type": "time_window",
        "parameters": {
          "window_size": 7,
          "window_step": 7,
          "time_column": "dt",
          "sort_first": true
        }
      },
      {
        "id": "n2",
        "name": "去重(检查已有)",
        "type": "dedup",
        "parameters": {
          "mode": "check_existing",
          "columns": "code,dt",
          "target_type": "duckdb",
          "target_config": "{\"db_path\": \"D:/data/etl_output.db\"}",
          "target_table": "stock_minute_kline",
          "keep_existing_rows": "0"
        }
      },
      {
        "id": "n3",
        "name": "写入DuckDB",
        "type": "target_write",
        "parameters": {
          "target_type": "duckdb",
          "target_config": "{\"db_path\": \"D:/data/etl_output.db\"}",
          "target_table": "stock_minute_kline",
          "batch_size": 5000,
          "on_duplicate": "ignore",
          "columns": ""
        }
      }
    ],
    "connections": {
      "n1": [
        "n2"
      ],
      "n2": [
        "n3"
      ]
    }
  }
}